{
  "name": "dsh-todo",
  "version": "1.0.0",
  "description": "A to-do list button in the DSH session header: rotating pending items tinted by urgency, plus a floating panel to add, edit and tick off tasks.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OverToWind/dsh-todo.git"
  },
  "homepage": "https://github.com/OverToWind/dsh-todo#readme",
  "bugs": {
    "url": "https://github.com/OverToWind/dsh-todo/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "todo",
    "task-list"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
